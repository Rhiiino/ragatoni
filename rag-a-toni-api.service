# rag-a-toni/rag-a-toni-api.service
# User unit: copy to ~/.config/systemd/user/ and enable, or run from rag-a-toni/README.
[Unit]
Description=RAG-a-toni FastAPI backend
After=network-online.target caddy.service
Wants=network-online.target

[Service]
WorkingDirectory=/home/mittens/Documents/myrepos/rag-a-toni/backend
Environment=HOME=/home/mittens
ExecStart=/home/mittens/Documents/myrepos/rag-a-toni/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8015 --app-dir src
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
