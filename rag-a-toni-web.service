# rag-a-toni/rag-a-toni-web.service
# User unit: copy to ~/.config/systemd/user/ and enable, or run from rag-a-toni/README.
[Unit]
Description=RAG-a-toni Vite frontend (preview)
After=network-online.target rag-a-toni-api.service
Wants=network-online.target

[Service]
WorkingDirectory=/home/mittens/Documents/myrepos/rag-a-toni/frontend
Environment=HOME=/home/mittens
Environment=PATH=/home/mittens/.nvm/versions/node/v22.22.0/bin:/usr/bin:/bin
ExecStartPre=/home/mittens/.nvm/versions/node/v22.22.0/bin/npm run build
ExecStart=/home/mittens/.nvm/versions/node/v22.22.0/bin/npm run preview
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
